# Production environment variables (example)

# App
APP_PORT=4000

# MongoDB (when using docker-compose.prod.yml built-in mongo service)
MONGO_INITDB_ROOT_USERNAME=nuxtshop
MONGO_INITDB_ROOT_PASSWORD=please-change-me
MONGODB_DB_NAME=NuxtShop

# Optional: if you want to use an external MongoDB instead of the built-in service,
# uncomment and replace the value below. docker-compose.prod.yml will prefer this.
# MONGODB_URI=mongodb://user:strong-password@your-mongo-host:27017/admin?authSource=admin

# Redis
REDIS_PASSWORD=please-change-me
REDIS_DB=0

# Admin account for backoffice / demo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# Frontend feature flags
# 0 = enable captcha, 1 = disable captcha
NUXT_PUBLIC_DISABLE_CAPTCHA=0
